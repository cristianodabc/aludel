<Layouts.app flash={@flash} current_path={@current_path} access={@access}>
  <div style="display: grid; grid-template-columns: 400px 1fr 1fr; height: calc(100vh - 60px); overflow-x: hidden; overflow-y: hidden;">
    <%!-- Column 1: Prompt & Controls --%>
    <div style="padding: 24px; overflow-y: auto; overflow-x: hidden; border-right: 1px solid var(--border);">
      <%= if @editing_suite_metadata do %>
        <.form
          for={@suite_form}
          id="suite-metadata-form"
          phx-change="validate_suite_metadata"
          phx-submit="save_suite_metadata"
          style="margin-bottom: 24px;"
        >
          <div style="margin-bottom: 12px;">
            <label style="font-size: 12px; font-weight: 500; display: block; margin-bottom: 4px;">
              Suite Name
            </label>
            <input
              type="text"
              id={@suite_form[:name].id}
              name={@suite_form[:name].name}
              value={@suite_form[:name].value}
              required
              style="width: 100%; padding: 8px; border: 1px solid var(--border); border-radius: 6px; background: var(--bg-secondary); font-size: 14px;"
            />
          </div>
          <div style="margin-bottom: 12px;">
            <.input
              field={@suite_form[:prompt_id]}
              type="select"
              label="Prompt"
              required
              options={Enum.map(@all_prompts, &{&1.name, &1.id})}
            />
          </div>
          <div style="margin-bottom: 12px;">
            <.input
              field={@suite_form[:project_id]}
              type="select"
              label="Project (optional)"
              prompt="No Project"
              options={Enum.map(@projects, &{&1.name, &1.id})}
            />
          </div>
          <div style="display: flex; gap: 8px; justify-content: flex-end;">
            <button
              type="button"
              phx-click="cancel_edit_suite_metadata"
              class="button-secondary"
              style="font-size: 13px; padding: 6px 12px;"
            >
              Cancel
            </button>
            <button
              type="submit"
              class="button-primary"
              style="font-size: 13px; padding: 6px 12px;"
            >
              Save
            </button>
          </div>
        </.form>
      <% else %>
        <div style="margin-bottom: 24px;">
          <h1 style="font-size: 24px; margin: 0 0 8px 0;">{@suite.name}</h1>
          <p style="color: var(--text-secondary); margin: 0 0 12px 0; font-size: 14px;">
            {@prompt.name}
          </p>
          <button
            phx-click="edit_suite_metadata"
            class="button-secondary"
            style="font-size: 13px; padding: 6px 12px; width: 100%;"
          >
            Edit Suite Details
          </button>
          <div style="margin-top: 8px; display: flex; flex-direction: column; gap: 8px;">
            <.link
              navigate={aludel_path("suites/#{@suite.id}/policy")}
              class="button-secondary"
              style="font-size: 13px; padding: 6px 12px; width: 100%; text-align: center;"
            >
              Manage policy
            </.link>
            <div
              :if={@active_policy}
              id="active-quality-policy"
              style="padding: 8px 10px; border-radius: 6px; background: color-mix(in srgb, #059669 10%, transparent); color: #059669; font-size: 12px; font-weight: 600; text-align: center;"
            >
              Policy v{@active_policy.version} active
            </div>
          </div>
        </div>
      <% end %>
      <div style="margin-bottom: 24px;">
        <h3 style="font-size: 14px; font-weight: 600; margin-bottom: 12px;">Run Suite</h3>
        <div style="margin-bottom: 12px;">
          <div style="font-size: 11px; font-weight: 500; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 4px;">
            Execution Mode
          </div>
          <div id="suite-execution-mode" style="font-size: 14px; color: var(--text-primary);">
            {@execution_mode_label}
          </div>
        </div>
        <.form
          for={@run_suite_form}
          id="run-suite-form"
          phx-change="validate_run_suite"
          phx-submit="run_suite"
          style="display: flex; flex-direction: column; gap: 12px;"
        >
          <div>
            <.input
              field={@run_suite_form[:version_id]}
              type="select"
              label="Version"
              required
              disabled={@running}
              options={Enum.map(@prompt.versions, &{"v#{&1.version}", &1.id})}
            />
          </div>
          <div>
            <.input
              field={@run_suite_form[:provider_id]}
              type="select"
              label="Provider"
              required
              disabled={@running}
              options={Enum.map(@providers, &{&1.name, &1.id})}
            />
          </div>
          <div>
            <.input
              field={@run_suite_form[:samples]}
              type="number"
              label="Attempts per test case"
              required
              disabled={@running}
              min="1"
              max="20"
              step="1"
            />
          </div>
          <div>
            <.input
              field={@run_suite_form[:reducer]}
              type="select"
              label="Pass rule"
              required
              disabled={@running}
              options={[
                {"All attempts must pass", "all"},
                {"Any attempt may pass", "any"},
                {"Strict majority must pass", "majority"},
                {"Minimum pass rate", "minimum_pass_rate"}
              ]}
            />
          </div>
          <div :if={@run_suite_form[:reducer].value == "minimum_pass_rate"}>
            <.input
              field={@run_suite_form[:minimum_pass_rate]}
              type="number"
              label="Minimum pass rate (%)"
              required
              disabled={@running}
              min="0"
              max="100"
              step="0.1"
            />
          </div>
          <div
            id="sampling-request-count"
            style="padding: 8px 10px; border-radius: 6px; background: var(--bg-tertiary); color: var(--text-secondary); font-size: 12px;"
          >
            {sampling_request_summary(@run_suite_form[:samples].value)} per test case. Every attempt is retained; judge assertions can add requests.
          </div>
          <button
            id="run-suite-btn"
            type="submit"
            class="button-primary"
            disabled={@running}
            style={"width: 100%; display: flex; align-items: center; gap: 8px; justify-content: center; #{if @running, do: "opacity: 0.6; cursor: not-allowed;", else: ""}"}
          >
            <%= if @running do %>
              <span style="display: inline-block; width: 14px; height: 14px; border: 2px solid currentColor; border-top-color: transparent; border-radius: 50%; animation: spin 0.6s linear infinite;"></span>
              Running...
            <% else %>
              Run Suite
            <% end %>
          </button>
        </.form>
      </div>
      <%= if @prompt.versions != [] do %>
        <div style="margin-bottom: 24px;">
          <h3 style="font-size: 14px; font-weight: 600; margin-bottom: 8px;">Prompt Template</h3>
          <pre
            id="selected-prompt-template"
            style="background-color: var(--bg-tertiary); border: 1px solid var(--border); padding: 12px; border-radius: 6px; font-size: 12px; line-height: 1.5; overflow-x: auto; white-space: pre-wrap; word-wrap: break-word; color: var(--text-secondary);"
          >{@selected_prompt_version.template}</pre>
        </div>
      <% end %>
    </div>
    <%!-- Column 2: Test Cases --%>
    <div style="padding: 24px; overflow-y: auto; overflow-x: hidden; border-right: 1px solid var(--border);">
      <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 16px;">
        <h2 style="margin: 0;">Test Cases</h2>
        <div style="display: flex; align-items: center; gap: 8px;">
          <button
            id="toggle-test-case-import"
            phx-click="toggle_test_case_import"
            class={["button-secondary"]}
            style="font-size: 13px; padding: 6px 12px;"
          >
            <.icon name="hero-arrow-up-tray" class="size-4" /> Import
          </button>
          <button
            id="add-test-case"
            phx-click="add_test_case"
            class={["button-primary"]}
            style="font-size: 13px; padding: 6px 12px;"
          >
            + Add Test Case
          </button>
        </div>
      </div>
      <section
        id="suite-dataset-import"
        style="margin-bottom: 16px; padding: 14px; border: 1px solid var(--border); border-radius: 9px; background: var(--bg-secondary);"
      >
        <.form
          for={@dataset_import_form}
          id="populate-suite-from-dataset-form"
          phx-submit="populate_from_dataset"
          style="display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; align-items: end;"
        >
          <.input
            id="suite-dataset-id"
            field={@dataset_import_form[:dataset_id]}
            type="select"
            label="Populate from dataset"
            prompt="Choose a dataset"
            options={Enum.map(@datasets, &{&1.name, &1.id})}
          />
          <div id="dataset-entry-submit-wrapper" class={["mb-3"]}>
            <button
              id="populate-suite-from-dataset"
              type="submit"
              class={["button-secondary", "h-10"]}
              disabled={@datasets == []}
            >
              Add entries
            </button>
          </div>
        </.form>
        <p
          :if={@dataset_import_status}
          id="dataset-import-status"
          style="margin: 8px 0 0; color: var(--text-secondary); font-size: 12px;"
        >
          {@dataset_import_status}
        </p>
      </section>
      <%= if @show_test_case_import do %>
        <section
          id="test-case-import-panel"
          style="margin-bottom: 16px; padding: 16px; border: 1px solid var(--border); border-radius: 10px; background: linear-gradient(145deg, var(--bg-secondary), var(--bg-primary));"
        >
          <div style="display: flex; justify-content: space-between; gap: 12px; margin-bottom: 12px;">
            <div>
              <h3 style="margin: 0 0 4px; font-size: 15px;">Import test cases</h3>
              <p style="margin: 0; color: var(--text-secondary); font-size: 12px; line-height: 1.5;">
                Upload CSV or JSON with input, expected, and assertion fields. Review validation before importing.
              </p>
            </div>
            <button
              id="cancel-test-case-import"
              type="button"
              phx-click="toggle_test_case_import"
              aria-label="Close import panel"
              class={["button-secondary"]}
              style="align-self: flex-start; padding: 6px;"
            >
              <.icon name="hero-x-mark" class="size-4" />
            </button>
          </div>

          <.form
            for={@test_case_import_form}
            id="test-case-import-form"
            phx-change="validate_test_case_import"
            phx-submit="preview_test_case_import"
          >
            <label
              for="test-case-import-file"
              style="display: block; padding: 16px; border: 1px dashed var(--border); border-radius: 8px; background-color: var(--bg-primary); cursor: pointer; text-align: center;"
            >
              <.icon name="hero-document-arrow-up" class="size-5" />
              <span style="display: block; margin-top: 6px; font-size: 13px; font-weight: 600;">
                Choose a .csv or .json file
              </span>
              <span style="display: block; margin-top: 2px; font-size: 11px; color: var(--text-muted);">
                Maximum file size: 2 MB
              </span>
            </label>
            <.live_file_input
              upload={@uploads.test_case_import}
              id="test-case-import-file"
              style="position: absolute; width: 1px; height: 1px; overflow: hidden; opacity: 0;"
            />

            <%= for entry <- @uploads.test_case_import.entries do %>
              <div
                id={"test-case-import-entry-#{entry.ref}"}
                style="display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 10px; padding: 8px 10px; border-radius: 6px; background-color: var(--bg-tertiary); font-size: 12px;"
              >
                <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                  {entry.client_name}
                </span>
                <button
                  type="button"
                  phx-click="cancel_test_case_import_upload"
                  phx-value-ref={entry.ref}
                  aria-label="Remove import file"
                  class={["button-secondary"]}
                  style="padding: 4px;"
                >
                  <.icon name="hero-x-mark" class="size-3" />
                </button>
              </div>
            <% end %>

            <button
              id="preview-test-case-import"
              type="submit"
              class={["button-primary"]}
              disabled={@uploads.test_case_import.entries == []}
              style="width: 100%; margin-top: 12px; font-size: 13px;"
            >
              Preview import
            </button>
          </.form>

          <%= if @test_case_import_preview && @uploads.test_case_import.entries == [] do %>
            <div
              id="test-case-import-preview"
              style="margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--border);"
            >
              <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px;">
                <div
                  id="test-case-import-valid-count"
                  style="padding: 10px; border-radius: 7px; background-color: color-mix(in srgb, #059669 10%, transparent); color: #059669;"
                >
                  <strong style="display: block; font-size: 18px;">
                    {@test_case_import_preview.summary.created}
                  </strong>
                  <span style="font-size: 11px;">Valid rows</span>
                </div>
                <div
                  id="test-case-import-rejected-count"
                  style="padding: 10px; border-radius: 7px; background-color: color-mix(in srgb, #dc2626 10%, transparent); color: #dc2626;"
                >
                  <strong style="display: block; font-size: 18px;">
                    {@test_case_import_preview.summary.rejected}
                  </strong>
                  <span style="font-size: 11px;">Rejected rows</span>
                </div>
              </div>

              <div
                :if={@test_case_import_preview.errors != []}
                id="test-case-import-errors"
                style="margin-top: 10px; display: flex; flex-direction: column; gap: 6px;"
              >
                <div
                  :for={error <- @test_case_import_preview.errors}
                  id={"test-case-import-error-#{error.row}"}
                  style="padding: 8px 10px; border-left: 3px solid #dc2626; background-color: var(--bg-tertiary); font-size: 12px; color: var(--text-secondary);"
                >
                  <strong style="color: var(--text-primary);">Row {error.row}:</strong>
                  {error.message}
                </div>
              </div>

              <button
                id="confirm-test-case-import"
                type="button"
                phx-click="confirm_test_case_import"
                class={["button-primary"]}
                disabled={@test_case_import_preview.summary.created == 0}
                style="width: 100%; margin-top: 12px; font-size: 13px;"
              >
                Import {@test_case_import_preview.summary.created} valid test case(s)
              </button>
            </div>
          <% end %>
        </section>
      <% end %>
      <div
        id="test-cases"
        phx-hook="AssertionTypeToggle"
        style="display: flex; flex-direction: column; gap: 16px;"
      >
        <%= for test_case <- @suite.test_cases do %>
          <div id={"test-case-#{test_case.id}"} class="aludel-card">
            <%= if @editing_test_case_id == test_case.id do %>
              <%!-- Edit Mode --%>
              <div style="background: var(--bg-secondary); padding: 20px;">
                <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 20px;">
                  <div style="width: 8px; height: 8px; background: var(--accent); border-radius: 50%; animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;">
                  </div>
                  <h4 style="margin: 0; font-size: 14px; font-weight: 600;">Editing</h4>
                </div>
                <.form
                  for={@test_case_form}
                  id={"test-case-form-#{test_case.id}"}
                  phx-submit="save_test_case"
                  phx-change="validate_test_case"
                >
                  <input
                    type="hidden"
                    id={@test_case_form[:id].id}
                    name={@test_case_form[:id].name}
                    value={test_case.id}
                  />
                  <%!-- Variables, Documents, Assertions in 3 columns --%>
                  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 16px; margin-bottom: 16px;">
                    <%!-- Variables Column --%>
                    <div>
                      <h4 style="font-size: 13px; font-weight: 600; margin-bottom: 8px;">
                        Variables
                      </h4>
                      <%= if test_case.variable_values == %{} do %>
                        <div style="color: var(--text-muted); font-size: 12px;">None</div>
                      <% else %>
                        <%= for {key, value} <- test_case.variable_values do %>
                          <div style="margin-bottom: 8px;">
                            <label style="font-size: 12px; color: var(--text-secondary); display: block; margin-bottom: 2px;">
                              {key}
                            </label>
                            <.input
                              type="text"
                              name={"#{@test_case_form.name}[variable_values][#{key}]"}
                              id={"#{@test_case_form.id}_variable_values_#{key}"}
                              value={
                                Map.get(
                                  @editing_test_case_params["variable_values"] || %{},
                                  key,
                                  value
                                )
                              }
                              class="w-full input text-[13px]"
                            />
                          </div>
                        <% end %>
                      <% end %>
                    </div>
                    <%!-- Documents Column --%>
                    <div>
                      <h4 style="font-size: 13px; font-weight: 600; margin-bottom: 8px;">
                        Documents
                      </h4>
                      <%= for doc <- test_case.documents do %>
                        <div style="display: flex; align-items: center; gap: 6px; margin-bottom: 6px; font-size: 12px;">
                          <span class="hero-document size-3"></span>
                          <span style="flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                            {doc.filename}
                          </span>
                          <button
                            type="button"
                            phx-click={show_modal("confirm-delete-document-#{doc.id}")}
                            aria-label="Delete document"
                            title="Delete document"
                            style="border: none; background: rgba(248, 81, 73, 0.1); cursor: pointer; color: #dc2626; padding: 4px 8px; border-radius: 4px; font-weight: 600; transition: all 0.15s ease;"
                            onmouseover="this.style.background='#dc2626'; this.style.color='white';"
                            onmouseout="this.style.background='rgba(248, 81, 73, 0.1)'; this.style.color='#dc2626';"
                          >
                            ✕
                          </button>
                        </div>
                      <% end %>
                      <label
                        phx-drop-target={@uploads.documents.ref}
                        style="display: block; border: 2px dashed rgba(139, 92, 246, 0.3); border-radius: 6px; padding: 16px; text-align: center; cursor: pointer; background: rgba(139, 92, 246, 0.05); transition: all 0.2s ease;"
                      >
                        <.live_file_input upload={@uploads.documents} class="hidden" />
                        <div style="font-size: 14px; font-weight: 500; color: var(--accent); margin-bottom: 4px;">
                          + Upload Document
                        </div>
                        <div style="font-size: 11px; color: var(--text-muted);">
                          PDF, PNG, JPG, CSV, JSON, TXT • Max 10MB • Up to 5 files
                        </div>
                      </label>
                      <%= for entry <- @uploads.documents.entries do %>
                        <div style="font-size: 12px; color: #10b981; margin-top: 4px;">
                          {entry.client_name}
                        </div>
                      <% end %>
                    </div>
                    <%!-- Assertions Column --%>
                    <div>
                      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                        <h4 style="font-size: 13px; font-weight: 600; margin: 0;">
                          Assertions
                        </h4>
                        <div style="display: flex; gap: 6px;">
                          <button
                            type="button"
                            phx-click="toggle_assertion_mode"
                            phx-value-id={test_case.id}
                            style="font-size: 11px; padding: 2px 8px; border: 1px solid var(--border); border-radius: 3px; background: var(--bg-secondary); cursor: pointer; font-weight: 500;"
                          >
                            {if Map.get(@assertion_edit_mode, test_case.id, :visual) == :visual,
                              do: "JSON",
                              else: "Visual"}
                          </button>
                          <%= if Map.get(@assertion_edit_mode, test_case.id, :visual) == :visual do %>
                            <button
                              type="button"
                              phx-click="add_assertion"
                              phx-value-id={test_case.id}
                              style="font-size: 12px; padding: 2px 6px; border: 1px solid var(--border); border-radius: 3px; background: var(--bg-secondary); cursor: pointer;"
                            >
                              +
                            </button>
                          <% end %>
                        </div>
                      </div>
                      <%= if Map.get(@assertion_edit_mode, test_case.id, :visual) == :visual do %>
                        <%= for {assertion, idx} <- Enum.with_index(@editing_assertions) do %>
                          <% current_type =
                            assertion_type_value(assertion, @editing_test_case_params, idx) %>
                          <div
                            id={"assertion-#{idx}"}
                            style="display: flex; flex-direction: column; gap: 6px; margin-bottom: 12px; padding: 10px; border: 1px solid var(--border); border-radius: 6px; background: var(--bg-tertiary);"
                          >
                            <div style="display: grid; grid-template-columns: minmax(0, 1fr) 38px; gap: 8px;">
                              <div style="min-width: 0;">
                                <.input
                                  type="select"
                                  name={"#{@test_case_form.name}[assertions][assertion_type_#{idx}]"}
                                  id={"assertion-type-#{idx}"}
                                  phx-hook="AssertionTypeToggle"
                                  data-index={idx}
                                  data-test-case-id={test_case.id}
                                  value={current_type}
                                  options={[
                                    {"contains", "contains"},
                                    {"not contains", "not_contains"},
                                    {"regex", "regex"},
                                    {"exact", "exact_match"},
                                    {"json field", "json_field"},
                                    {"json deep compare", "json_deep_compare"},
                                    {"rubric judge", "rubric_judge"}
                                  ]}
                                  class="w-full select text-[13px]"
                                />
                              </div>
                              <button
                                type="button"
                                phx-click="remove_assertion"
                                phx-value-index={idx}
                                phx-value-id={test_case.id}
                                aria-label="Remove assertion"
                                title="Remove assertion"
                                class="remove-assertion-btn"
                                style="width: 34px; height: 32px; position: relative; top: 4px;"
                              >
                                ✕
                              </button>
                            </div>
                            <%= cond do %>
                              <% current_type == "json_field" -> %>
                                <div
                                  id={"json-fields-#{test_case.id}-#{idx}"}
                                  style="display: flex; flex-direction: column; gap: 6px;"
                                >
                                  <div style="display: flex; flex-direction: column; gap: 4px;">
                                    <label style="font-size: 11px; color: var(--text-muted);">
                                      Field path (e.g., "user.name"):
                                    </label>
                                    <.input
                                      type="text"
                                      name={"#{@test_case_form.name}[assertions][assertion_field_#{idx}]"}
                                      id={"#{@test_case_form.id}_assertion_field_#{idx}"}
                                      value={
                                        assertion_text_value(
                                          assertion,
                                          @editing_test_case_params,
                                          idx,
                                          "field",
                                          "field"
                                        )
                                      }
                                      placeholder="invoice_number"
                                      class="input text-[13px]"
                                    />
                                  </div>
                                  <div style="display: flex; flex-direction: column; gap: 4px;">
                                    <label style="font-size: 11px; color: var(--text-muted);">
                                      Expected value:
                                    </label>
                                    <.input
                                      type="text"
                                      name={"#{@test_case_form.name}[assertions][assertion_expected_#{idx}]"}
                                      id={"#{@test_case_form.id}_assertion_expected_#{idx}"}
                                      value={
                                        assertion_text_value(
                                          assertion,
                                          @editing_test_case_params,
                                          idx,
                                          "expected",
                                          "expected"
                                        )
                                      }
                                      placeholder="INV-001"
                                      class="input text-[13px]"
                                    />
                                    <input
                                      type="hidden"
                                      name={
                                        "#{@test_case_form.name}[assertions][assertion_expected_json_value_#{idx}]"
                                      }
                                      id={"#{@test_case_form.id}_assertion_expected_json_value_#{idx}"}
                                      value={
                                        assertion_expected_json_value_for_json_field(
                                          assertion,
                                          @editing_test_case_params,
                                          idx
                                        )
                                      }
                                    />
                                  </div>
                                </div>
                              <% current_type == "json_deep_compare" -> %>
                                <div
                                  id={"deep-compare-fields-#{test_case.id}-#{idx}"}
                                  style="display: flex; flex-direction: column; gap: 6px;"
                                >
                                  <div style="display: flex; flex-direction: column; gap: 4px;">
                                    <label style="font-size: 11px; color: var(--text-muted);">
                                      Expected JSON:
                                    </label>
                                    <.input
                                      type="textarea"
                                      name={"#{@test_case_form.name}[assertions][assertion_expected_json_#{idx}]"}
                                      id={"#{@test_case_form.id}_assertion_expected_json_#{idx}"}
                                      value={
                                        assertion_expected_json_value(
                                          assertion,
                                          @editing_test_case_params,
                                          idx
                                        )
                                      }
                                      rows="6"
                                      placeholder={~s({"status":"ok","count":2})}
                                      class="json-editor w-full textarea"
                                    />
                                  </div>
                                  <div style="display: flex; flex-direction: column; gap: 4px;">
                                    <label style="font-size: 11px; color: var(--text-muted);">
                                      Pass threshold (optional, defaults to 100):
                                    </label>
                                    <.input
                                      type="text"
                                      name={"#{@test_case_form.name}[assertions][assertion_threshold_#{idx}]"}
                                      id={"#{@test_case_form.id}_assertion_threshold_#{idx}"}
                                      value={
                                        assertion_threshold_value(
                                          assertion,
                                          @editing_test_case_params,
                                          idx
                                        )
                                      }
                                      placeholder="80.0"
                                      class="input text-[13px]"
                                    />
                                  </div>
                                </div>
                              <% current_type == "rubric_judge" -> %>
                                <% rubric_source =
                                  assertion_rubric_source_value(
                                    assertion,
                                    @editing_test_case_params,
                                    idx
                                  ) %>
                                <% judge_provider_id =
                                  assertion_text_value(
                                    assertion,
                                    @editing_test_case_params,
                                    idx,
                                    "provider_id",
                                    "provider_id"
                                  ) %>
                                <div
                                  id={"judge-fields-#{test_case.id}-#{idx}"}
                                  style="display: flex; flex-direction: column; gap: 10px;"
                                >
                                  <.input
                                    type="select"
                                    name={"#{@test_case_form.name}[assertions][assertion_rubric_source_#{idx}]"}
                                    value={rubric_source}
                                    options={[
                                      {"Built-in judge", "template"},
                                      {"Custom rubric", "custom"}
                                    ]}
                                    id={"#{@test_case_form.id}_assertion_rubric_source_#{idx}"}
                                    label="Judge criteria"
                                  />
                                  <%= if rubric_source == "custom" do %>
                                    <.input
                                      type="textarea"
                                      name={"#{@test_case_form.name}[assertions][assertion_rubric_#{idx}]"}
                                      value={
                                        assertion_text_value(
                                          assertion,
                                          @editing_test_case_params,
                                          idx,
                                          "rubric",
                                          "rubric"
                                        )
                                      }
                                      id={"#{@test_case_form.id}_assertion_rubric_#{idx}"}
                                      label="Custom rubric"
                                      maxlength="4000"
                                      rows="5"
                                      placeholder="Describe exactly how the response should be scored."
                                    />
                                  <% else %>
                                    <.input
                                      type="select"
                                      name={"#{@test_case_form.name}[assertions][assertion_template_#{idx}]"}
                                      value={
                                        assertion_text_value(
                                          assertion,
                                          @editing_test_case_params,
                                          idx,
                                          "template",
                                          "template"
                                        )
                                      }
                                      options={
                                        Enum.map(
                                          @judge_templates,
                                          &{"#{&1.name} — #{&1.description}", &1.id}
                                        )
                                      }
                                      prompt="Choose a built-in judge"
                                      id={"#{@test_case_form.id}_assertion_template_#{idx}"}
                                      label="Built-in judge"
                                    />
                                  <% end %>
                                  <.input
                                    type="select"
                                    name={"#{@test_case_form.name}[assertions][assertion_provider_id_#{idx}]"}
                                    value={judge_provider_id}
                                    options={
                                      judge_provider_options(@providers, judge_provider_id)
                                    }
                                    prompt="Choose a judge provider"
                                    id={"#{@test_case_form.id}_assertion_provider_id_#{idx}"}
                                    label="Judge provider"
                                  />
                                  <.input
                                    type="number"
                                    name={"#{@test_case_form.name}[assertions][assertion_threshold_#{idx}]"}
                                    value={
                                      assertion_threshold_value(
                                        assertion,
                                        @editing_test_case_params,
                                        idx
                                      )
                                    }
                                    min="0"
                                    max="100"
                                    step="0.1"
                                    placeholder="80"
                                    id={"#{@test_case_form.id}_assertion_threshold_#{idx}"}
                                    label="Pass threshold (defaults to 80)"
                                  />
                                  <.input
                                    type="textarea"
                                    name={"#{@test_case_form.name}[assertions][assertion_expected_#{idx}]"}
                                    value={
                                      assertion_text_value(
                                        assertion,
                                        @editing_test_case_params,
                                        idx,
                                        "expected",
                                        "expected"
                                      )
                                    }
                                    id={"#{@test_case_form.id}_assertion_expected_#{idx}"}
                                    label="Reference answer (optional)"
                                    rows="3"
                                  />
                                  <input
                                    type="hidden"
                                    name={"#{@test_case_form.name}[assertions][assertion_expected_json_value_#{idx}]"}
                                    value={
                                      assertion_evidence_json_value(
                                        assertion,
                                        @editing_test_case_params,
                                        idx,
                                        "expected"
                                      )
                                    }
                                    id={"#{@test_case_form.id}_assertion_expected_json_value_#{idx}"}
                                  />
                                  <.input
                                    type="textarea"
                                    name={"#{@test_case_form.name}[assertions][assertion_context_#{idx}]"}
                                    value={
                                      assertion_text_value(
                                        assertion,
                                        @editing_test_case_params,
                                        idx,
                                        "context",
                                        "context"
                                      )
                                    }
                                    id={"#{@test_case_form.id}_assertion_context_#{idx}"}
                                    label="Grounding context (optional)"
                                    rows="3"
                                  />
                                  <input
                                    type="hidden"
                                    name={"#{@test_case_form.name}[assertions][assertion_context_json_value_#{idx}]"}
                                    value={
                                      assertion_evidence_json_value(
                                        assertion,
                                        @editing_test_case_params,
                                        idx,
                                        "context"
                                      )
                                    }
                                    id={"#{@test_case_form.id}_assertion_context_json_value_#{idx}"}
                                  />
                                </div>
                              <% true -> %>
                                <div
                                  id={"value-field-#{test_case.id}-#{idx}"}
                                  style="display: flex; flex-direction: column; gap: 4px;"
                                >
                                  <label style="font-size: 11px; color: var(--text-muted);">
                                    Value to match:
                                  </label>
                                  <.input
                                    type="text"
                                    name={"#{@test_case_form.name}[assertions][assertion_value_#{idx}]"}
                                    id={"#{@test_case_form.id}_assertion_value_#{idx}"}
                                    value={
                                      assertion_text_value(
                                        assertion,
                                        @editing_test_case_params,
                                        idx,
                                        "value",
                                        "value"
                                      )
                                    }
                                    placeholder="text to find"
                                    class="input text-[13px]"
                                  />
                                </div>
                            <% end %>
                          </div>
                        <% end %>
                      <% else %>
                        <.input
                          type="textarea"
                          name={@test_case_form[:assertions_json].name}
                          id={"test_case_#{test_case.id}_assertions_json"}
                          rows="8"
                          value={@editing_test_case_params["assertions_json"]}
                          placeholder='[{"type": "contains", "value": "expected text"}]'
                          class="json-editor w-full textarea"
                        />
                        <div style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">
                          Types: contains, not_contains, regex, exact_match, json_field, json_deep_compare, rubric_judge, typed_judge
                        </div>
                      <% end %>
                      <%= if @test_case_form[:assertions_json].errors != [] do %>
                        <p
                          id={"test-case-assertions-error-#{test_case.id}"}
                          style="font-size: 11px; color: #dc2626; margin-top: 6px;"
                        >
                          {Enum.map_join(
                            @test_case_form[:assertions_json].errors,
                            ", ",
                            fn {message, _opts} ->
                              message
                            end
                          )}
                        </p>
                      <% end %>
                    </div>
                  </div>
                  <div style="display: flex; gap: 8px; justify-content: flex-end;">
                    <button type="button" phx-click="cancel_edit" class="button-secondary">
                      Cancel
                    </button>
                    <button type="submit" class="button-primary">Save</button>
                  </div>
                </.form>
              </div>
            <% else %>
              <%!-- Display Mode --%>
              <div>
                <div
                  :if={test_case.source_dataset_entry}
                  id={"test-case-provenance-#{test_case.id}"}
                  style="margin-bottom: 12px; padding: 8px 10px; border-radius: 6px; background: color-mix(in srgb, var(--accent) 8%, transparent); color: var(--text-secondary); font-size: 12px;"
                >
                  From dataset
                  <.link
                    navigate={
                      aludel_path("datasets/#{test_case.source_dataset_entry.dataset.id}")
                    }
                    style="font-weight: 600;"
                  >
                    {test_case.source_dataset_entry.dataset.name}
                  </.link>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                  <div style="display: flex; align-items: center; gap: 10px;">
                    <div style="width: 32px; height: 32px; background: linear-gradient(135deg, var(--accent) 0%, rgba(139, 92, 246, 0.7) 100%); border-radius: 8px; display: flex; align-items: center; justify-content: center; color: white; font-weight: 600; font-size: 14px; box-shadow: 0 2px 4px rgba(139, 92, 246, 0.2);">
                      {length(@suite.test_cases) -
                        Enum.find_index(@suite.test_cases, &(&1.id == test_case.id))}
                    </div>
                    <h4 style="margin: 0; font-size: 15px; font-weight: 600;">Test Case</h4>
                  </div>
                  <div style="display: flex; gap: 8px;">
                    <button
                      phx-click="edit_test_case"
                      phx-value-id={test_case.id}
                      class="button-secondary"
                      style="padding: 6px 14px; font-size: 13px;"
                    >
                      Edit
                    </button>
                    <button
                      phx-click={show_modal("confirm-delete-test-case-#{test_case.id}")}
                      style="padding: 6px 14px; font-size: 13px; border: 1px solid rgba(220, 38, 38, 0.3); background: rgba(220, 38, 38, 0.05); color: #dc2626; border-radius: 6px; cursor: pointer; font-weight: 500; transition: all 0.15s ease;"
                      onmouseover="this.style.background='#dc2626'; this.style.borderColor='#dc2626'; this.style.color='white';"
                      onmouseout="this.style.background='rgba(220, 38, 38, 0.05)'; this.style.borderColor='rgba(220, 38, 38, 0.3)'; this.style.color='#dc2626';"
                    >
                      Delete
                    </button>
                  </div>
                </div>
                <div
                  :if={test_case.messages != []}
                  style="display: flex; flex-direction: column; gap: 6px; margin-bottom: 16px;"
                >
                  <div
                    :for={{message, index} <- Enum.with_index(test_case.messages)}
                    id={"test-case-message-#{test_case.id}-#{index}"}
                    style="display: grid; grid-template-columns: 76px minmax(0, 1fr); gap: 8px; padding: 8px 10px; border-radius: 6px; background: var(--bg-tertiary); font-size: 12px;"
                  >
                    <strong style="color: var(--accent); text-transform: capitalize;">{message[
                      "role"
                    ]}</strong>
                    <span style="white-space: pre-wrap;">{message["content"]}</span>
                  </div>
                </div>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px;">
                  <%!-- Variables --%>
                  <div style="background: var(--bg-tertiary); padding: 12px; border-radius: 8px; border: 1px solid var(--border);">
                    <div style="display: flex; align-items: center; gap: 6px; margin-bottom: 10px;">
                      <span class="hero-variable size-4" style="color: var(--accent);"></span>
                      <h4 style="font-size: 12px; font-weight: 600; margin: 0; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary);">
                        Variables
                      </h4>
                    </div>
                    <%= if test_case.variable_values == %{} do %>
                      <div style="color: var(--text-muted); font-size: 13px; font-style: italic;">
                        No variables
                      </div>
                    <% else %>
                      <%= for {key, value} <- test_case.variable_values do %>
                        <div style="font-size: 13px; margin-bottom: 6px; padding: 6px 8px; background: var(--bg-secondary); border-radius: 4px;">
                          <span style="font-weight: 600; color: var(--accent);">{key}:</span>
                          <span style="color: var(--text-primary);">{value}</span>
                        </div>
                      <% end %>
                    <% end %>
                  </div>
                  <%!-- Documents --%>
                  <div style="background: var(--bg-tertiary); padding: 12px; border-radius: 8px; border: 1px solid var(--border);">
                    <div style="display: flex; align-items: center; gap: 6px; margin-bottom: 10px;">
                      <span class="hero-document size-4" style="color: var(--accent);"></span>
                      <h4 style="font-size: 12px; font-weight: 600; margin: 0; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary);">
                        Documents
                      </h4>
                    </div>
                    <%= if test_case.documents == [] do %>
                      <div style="color: var(--text-muted); font-size: 13px; font-style: italic;">
                        No documents
                      </div>
                    <% else %>
                      <%= for doc <- test_case.documents do %>
                        <div style="font-size: 13px; margin-bottom: 6px; padding: 6px 8px; background: var(--bg-secondary); border-radius: 4px; display: flex; align-items: center; gap: 6px;">
                          <span class="hero-document size-3" style="color: var(--accent);"></span>
                          <span style="color: var(--text-primary); flex: 1;">{doc.filename}</span>
                          <span style="color: var(--text-muted); font-size: 11px;">
                            {doc.size_bytes} bytes
                          </span>
                        </div>
                      <% end %>
                    <% end %>
                  </div>
                  <%!-- Assertions --%>
                  <div style="background: var(--bg-tertiary); padding: 12px; border-radius: 8px; border: 1px solid var(--border);">
                    <div style="display: flex; align-items: center; gap: 6px; margin-bottom: 10px;">
                      <span class="hero-check-circle size-4" style="color: var(--accent);"></span>
                      <h4 style="font-size: 12px; font-weight: 600; margin: 0; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary);">
                        Assertions
                      </h4>
                    </div>
                    <%= if test_case.assertions == [] do %>
                      <div style="color: var(--text-muted); font-size: 13px; font-style: italic;">
                        No assertions
                      </div>
                    <% else %>
                      <%= for {assertion, assertion_idx} <- Enum.with_index(test_case.assertions) do %>
                        <div style="font-size: 13px; margin-bottom: 6px; padding: 6px 8px; background: var(--bg-secondary); border-radius: 4px;">
                          <%= cond do %>
                            <% assertion["type"] == "json_field" -> %>
                              <div style="margin-bottom: 2px;">
                                <span style="font-weight: 600; color: var(--accent);">
                                  json field:
                                </span>
                              </div>
                              <div style="font-size: 12px; padding-left: 8px;">
                                <span style="color: var(--text-secondary);">field:</span>
                                <span style="font-family: monospace; color: var(--text-primary);">
                                  {assertion["field"]}
                                </span>
                              </div>
                              <div style="font-size: 12px; padding-left: 8px;">
                                <span style="color: var(--text-secondary);">expected:</span>
                                <span style="font-family: monospace; color: var(--text-primary);">
                                  {assertion["expected"]}
                                </span>
                              </div>
                            <% assertion["type"] == "json_deep_compare" -> %>
                              <div style="margin-bottom: 2px;">
                                <span style="font-weight: 600; color: var(--accent);">
                                  json deep compare:
                                </span>
                              </div>
                              <div style="font-size: 12px; padding-left: 8px;">
                                <span style="color: var(--text-secondary);">expected:</span>
                                <pre style="margin: 4px 0 0; font-family: monospace; font-size: 12px; color: var(--text-primary); white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-word;">{Jason.encode!(assertion["expected"], pretty: true)}</pre>
                              </div>
                              <%= if assertion["threshold"] do %>
                                <div style="font-size: 12px; padding-left: 8px;">
                                  <span style="color: var(--text-secondary);">threshold:</span>
                                  <span style="font-family: monospace; color: var(--text-primary);">
                                    {assertion["threshold"]}%
                                  </span>
                                </div>
                              <% end %>
                            <% assertion["type"] == "rubric_judge" -> %>
                              <div
                                id={"rubric-judge-#{test_case.id}-#{assertion_idx}"}
                                style="display: flex; flex-direction: column; gap: 4px;"
                              >
                                <div>
                                  <span style="font-weight: 600; color: var(--accent);">
                                    rubric judge:
                                  </span>
                                  <span style="color: var(--text-primary);">
                                    {judge_source_label(assertion)}
                                  </span>
                                </div>
                                <div style="font-size: 12px; padding-left: 8px;">
                                  <span style="color: var(--text-secondary);">provider:</span>
                                  <span style="color: var(--text-primary);">
                                    {judge_provider_name(@providers, assertion["provider_id"])}
                                  </span>
                                </div>
                                <div style="font-size: 12px; padding-left: 8px;">
                                  <span style="color: var(--text-secondary);">threshold:</span>
                                  <span style="font-family: monospace; color: var(--text-primary);">
                                    {assertion["threshold"] || 80}%
                                  </span>
                                </div>
                                <div
                                  :if={assertion["rubric"]}
                                  style="font-size: 12px; padding-left: 8px;"
                                >
                                  <span style="color: var(--text-secondary);">rubric:</span>
                                  <span style="color: var(--text-primary);">
                                    {assertion["rubric"]}
                                  </span>
                                </div>
                                <div
                                  :if={assertion["expected"]}
                                  style="font-size: 12px; padding-left: 8px;"
                                >
                                  <span style="color: var(--text-secondary);">reference:</span>
                                  <span style="color: var(--text-primary);">
                                    {display_value(assertion["expected"])}
                                  </span>
                                </div>
                                <div
                                  :if={assertion["context"]}
                                  style="font-size: 12px; padding-left: 8px;"
                                >
                                  <span style="color: var(--text-secondary);">context:</span>
                                  <span style="color: var(--text-primary);">
                                    {display_value(assertion["context"])}
                                  </span>
                                </div>
                              </div>
                            <% assertion["type"] == "typed_judge" -> %>
                              <div
                                id={"typed-judge-#{test_case.id}-#{assertion_idx}"}
                                style="display: flex; flex-direction: column; gap: 4px;"
                              >
                                <div>
                                  <span style="font-weight: 600; color: var(--accent);">
                                    typed judge:
                                  </span>
                                  <span style="color: var(--text-primary);">
                                    {assertion["kind"]}
                                  </span>
                                </div>
                                <div style="font-size: 12px; padding-left: 8px;">
                                  <span style="color: var(--text-secondary);">question:</span>
                                  <span style="color: var(--text-primary);">
                                    {assertion["question"]}
                                  </span>
                                </div>
                                <div
                                  :if={assertion["expected"]}
                                  style="font-size: 12px; padding-left: 8px;"
                                >
                                  <span style="color: var(--text-secondary);">expected:</span>
                                  <span style="font-family: monospace; color: var(--text-primary);">
                                    {assertion["expected"]}
                                  </span>
                                </div>
                                <div
                                  :if={assertion["threshold"]}
                                  style="font-size: 12px; padding-left: 8px;"
                                >
                                  <span style="color: var(--text-secondary);">threshold:</span>
                                  <span style="font-family: monospace; color: var(--text-primary);">
                                    {assertion["threshold"]}
                                  </span>
                                </div>
                                <div
                                  :if={assertion["min_confidence"]}
                                  style="font-size: 12px; padding-left: 8px;"
                                >
                                  <span style="color: var(--text-secondary);">
                                    min confidence:
                                  </span>
                                  <span style="font-family: monospace; color: var(--text-primary);">
                                    {assertion["min_confidence"]}
                                  </span>
                                </div>
                              </div>
                            <% true -> %>
                              <span style="font-weight: 600; color: var(--accent);">
                                {assertion["type"]}:
                              </span>
                              <span style="font-family: monospace; color: var(--text-primary);">
                                {assertion["value"]}
                              </span>
                          <% end %>
                        </div>
                      <% end %>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
    <%!-- Column 3: Results --%>
    <div style="padding: 24px; overflow-y: auto; overflow-x: hidden;">
      <h2 style="margin-bottom: 16px;">Results</h2>
      <%= if @running do %>
        <div class="aludel-card" style="padding: 24px; text-align: center;">
          <div style="display: inline-block; width: 40px; height: 40px; border: 3px solid var(--border); border-top-color: var(--primary); border-radius: 50%; animation: spin 0.6s linear infinite; margin-bottom: 16px;">
          </div>
          <div style="color: var(--text-secondary); font-size: 14px; margin-bottom: 8px;">
            Executing test cases against the LLM...
          </div>
          <div style="font-size: 12px; color: var(--text-muted);">
            This may take a few moments depending on the number of test cases.
          </div>
        </div>
      <% end %>
      <%= if @suite_runs != [] do %>
        <div style="display: flex; flex-direction: column; gap: 16px;">
          <%= for suite_run <- @suite_runs do %>
            <div class="aludel-card">
              <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 12px;">
                <div>
                  <div style="font-weight: 600; margin-bottom: 4px;">
                    v{suite_run.prompt_version.version} @ {suite_run.provider.name}
                  </div>
                  <div style="color: var(--text-secondary); font-size: 13px;">
                    {relative_time(suite_run.inserted_at)}
                  </div>
                </div>
                <div style="text-align: right;">
                  <div style="color: var(--text-secondary); font-size: 13px; margin-bottom: 4px;">
                    Passed: {suite_run.passed} | Failed: {suite_run.failed}
                  </div>
                  <div style="font-size: 12px; color: var(--text-muted);">
                    {suite_run.passed + suite_run.failed} test cases
                  </div>
                  <%= if format_score(suite_run.avg_score) do %>
                    <div
                      id={"suite-run-score-#{suite_run.id}"}
                      style="font-size: 12px; color: #8b5cf6; font-weight: 600; margin-top: 4px;"
                    >
                      {format_score(suite_run.avg_score)}% avg score
                    </div>
                  <% end %>
                  <div style="margin-top: 8px; display: flex; justify-content: flex-end; gap: 6px;">
                    <.link
                      id={"open-suite-report-#{suite_run.id}"}
                      navigate={aludel_path("suites/runs/#{suite_run.id}/report")}
                      style="display: inline-flex; flex-shrink: 0; white-space: nowrap; border: 1px solid var(--border); background: var(--bg-secondary); color: var(--text-secondary); border-radius: 8px; padding: 4px 16px; font-size: 11px; font-weight: 600; cursor: pointer; text-decoration: none; transition: background-color 0.2s ease, color 0.2s ease;"
                    >
                      Reports
                    </.link>
                    <a
                      id={"export-suite-run-#{suite_run.id}"}
                      href={aludel_path("suites/runs/#{suite_run.id}/export")}
                      download
                      style="display: inline-flex; flex-shrink: 0; white-space: nowrap; border: 1px solid var(--border); background: var(--bg-secondary); color: var(--text-secondary); border-radius: 8px; padding: 4px 16px; font-size: 11px; font-weight: 600; cursor: pointer; text-decoration: none; transition: background-color 0.2s ease, color 0.2s ease;"
                    >
                      Export JSON
                    </a>
                  </div>
                </div>
              </div>
              <div
                :if={is_map(suite_run.quality_policy_result)}
                id={"suite-run-policy-#{suite_run.id}"}
                style="margin-bottom: 12px; padding: 12px; border-radius: 7px; border: 1px solid var(--border); background: var(--bg-secondary);"
              >
                <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 10px;">
                  <strong style="font-size: 13px;">
                    Policy v{suite_run.quality_policy_result["policy_version"]}
                  </strong>
                  <span style={"font-size: 12px; font-weight: 600; color: #{policy_status_color(suite_run.quality_policy_result["status"])}"}>
                    {policy_status_label(suite_run.quality_policy_result["status"])}
                  </span>
                </div>
                <div style="display: flex; flex-direction: column; gap: 8px;">
                  <div
                    :for={rule <- policy_rules(suite_run.quality_policy_result)}
                    id={"suite-run-policy-rule-#{suite_run.id}-#{policy_rule_dom_id(rule["id"])}"}
                    style="padding: 9px 10px; border-radius: 6px; background: var(--bg-tertiary); font-size: 12px;"
                  >
                    <div style="display: flex; justify-content: space-between; gap: 10px; margin-bottom: 4px;">
                      <strong>{policy_rule_label(rule["type"])}</strong>
                      <span style={"font-weight: 600; color: #{policy_status_color(rule["status"])}"}>
                        {policy_status_label(rule["status"])}
                      </span>
                    </div>
                    <div style="color: var(--text-secondary);">
                      {policy_rule_actual(rule)} · {policy_rule_requirement(rule)}
                    </div>
                  </div>
                </div>
              </div>
              <div style="background-color: var(--bg-tertiary); padding: 16px; border-radius: 6px;">
                <%= for result <- suite_run.results do %>
                  <div style="margin-bottom: 12px; border-radius: 8px; background: var(--bg-secondary); border: 1px solid var(--border); overflow: hidden;">
                    <details
                      :if={sampled_result?(result)}
                      id={"suite-result-sampling-#{suite_run.id}-#{result["test_case_id"]}"}
                      style="padding: 12px; border-bottom: 1px solid var(--border); background: color-mix(in srgb, var(--accent) 6%, transparent);"
                    >
                      <summary style="cursor: pointer; color: var(--text-primary); font-size: 12px; font-weight: 600;">
                        {sampling_pass_summary(result["sampling"])} · {sampling_reducer_label(
                          result["sampling"]
                        )} · {sampling_pass_rate(result["sampling"])} pass rate
                      </summary>
                      <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 10px;">
                        <div
                          :for={
                            {attempt, attempt_number} <-
                              Enum.with_index(result["attempts"], 1)
                          }
                          id={"suite-result-attempt-#{suite_run.id}-#{result["test_case_id"]}-#{attempt_number}"}
                          style="padding: 10px; border-radius: 6px; background: var(--bg-secondary); border: 1px solid var(--border);"
                        >
                          <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 6px;">
                            <strong style="font-size: 12px;">Attempt {attempt_number}</strong>
                            <span style={"font-size: 11px; font-weight: 600; color: #{if attempt["passed"], do: "#10b981", else: "#f85149"}"}>
                              {if attempt["passed"], do: "Passed", else: "Failed"}
                              <%= if score = format_score(attempt["score"]) do %>
                                · {score}%
                              <% end %>
                            </span>
                          </div>
                          <pre style="font-size: 12px; margin: 0; white-space: pre-wrap; color: var(--text-primary); line-height: 1.5;">{attempt["output"]}</pre>
                        </div>
                      </div>
                    </details>
                    <%= if result["assertion_results"] && result["assertion_results"] != [] do %>
                      <div
                        id={"suite-result-assertions-#{suite_run.id}-#{result["test_case_id"]}"}
                        style="padding: 12px; border-bottom: 1px solid var(--border);"
                      >
                        <div style="font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 10px;">
                          Assertions
                        </div>
                        <%= for {assertion, assertion_index} <- Enum.with_index(result["assertion_results"]) do %>
                          <%= if assertion["reason"] do %>
                            <div
                              id={"suite-result-metric-reason-#{suite_run.id}-#{result["test_case_id"]}-#{assertion_index}"}
                              style="margin-bottom: 8px; padding: 8px 10px; border-radius: 6px; background: var(--bg-tertiary); color: var(--text-secondary); font-size: 12px;"
                            >
                              {assertion["reason"]}
                            </div>
                          <% end %>
                        <% end %>
                        <div
                          id={"suite-result-assertions-table-#{suite_run.id}-#{result["test_case_id"]}"}
                          style="overflow-x: auto; max-width: 100%;"
                        >
                          <table style="width: 100%; min-width: 640px; border-collapse: collapse;">
                            <thead>
                              <tr style="border-bottom: 1px solid var(--border);">
                                <th style="text-align: left; padding: 6px 8px; font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; width: 60px;">
                                  Match
                                </th>
                                <th style="text-align: left; padding: 6px 8px; font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase;">
                                  Detail
                                </th>
                                <th style="text-align: left; padding: 6px 8px; font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase;">
                                  Expected
                                </th>
                                <th style="text-align: left; padding: 6px 8px; font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase;">
                                  Actual
                                </th>
                              </tr>
                            </thead>
                            <tbody>
                              <%= for row <- assertion_result_rows(result["assertion_results"]) do %>
                                <tr style="border-bottom: 1px solid var(--border-muted);">
                                  <td style="padding: 8px; vertical-align: top;">
                                    <span style={"display: inline-flex; align-items: center; justify-content: center; width: 20px; height: 20px; border-radius: 4px; font-weight: 600; font-size: 12px; background: #{if row.passed, do: "rgba(16, 185, 129, 0.1)", else: "rgba(248, 81, 73, 0.1)"}; color: #{if row.passed, do: "#10b981", else: "#f85149"}"}>
                                      {if row.passed, do: "✓", else: "✗"}
                                    </span>
                                  </td>
                                  <td style="padding: 8px; font-size: 12px; line-height: 20px; color: var(--text-secondary); font-weight: 500; font-family: monospace; vertical-align: top;">
                                    {row.detail}
                                  </td>
                                  <td style="padding: 8px; font-size: 12px; line-height: 20px; font-family: monospace; color: var(--text-primary); overflow-wrap: anywhere; word-break: break-word; vertical-align: top;">
                                    <span style="white-space: pre-wrap;">{display_value(
                                      row.expected
                                    )}</span>
                                  </td>
                                  <td style="padding: 8px; font-size: 12px; line-height: 20px; font-family: monospace; color: var(--text-primary); overflow-wrap: anywhere; word-break: break-word; vertical-align: top;">
                                    <span style="white-space: pre-wrap;">{display_value(
                                      row.actual
                                    )}</span>
                                  </td>
                                </tr>
                              <% end %>
                            </tbody>
                          </table>
                        </div>
                      </div>
                    <% end %>
                    <div style={"padding: 14px; background: #{if result["passed"], do: "rgba(16, 185, 129, 0.05)", else: "rgba(248, 81, 73, 0.05)"}"}>
                      <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 8px;">
                        <div style="display: flex; flex-direction: column; align-items: start; gap: 4px;">
                          <div style="display: flex; align-items: center; gap: 8px;">
                            <span style={"font-weight: 600; font-size: 13px; color: #{if result["passed"], do: "#10b981", else: "#f85149"}"}>
                              {if result["passed"], do: "✓ Output", else: "✗ Output"}
                            </span>
                            <%= if score = format_score(result["score"]) do %>
                              <span
                                id={"suite-result-score-#{suite_run.id}-#{result["test_case_id"]}"}
                                style="font-size: 12px; font-weight: 600; color: #8b5cf6;"
                              >
                                {score}% match
                              </span>
                            <% end %>
                          </div>
                          <%= if retry_count(result) > 0 do %>
                            <div
                              id={"suite-result-retry-meta-#{suite_run.id}-#{result["test_case_id"]}"}
                              style="font-size: 11px; color: var(--text-muted);"
                            >
                              {"Retry ##{retry_count(result)}"}
                              <%= if retried_at_time = retried_at(result) do %>
                                <span>{" • #{relative_time(retried_at_time)}"}</span>
                              <% end %>
                            </div>
                          <% end %>
                        </div>
                        <div style="display: flex; align-items: center; gap: 8px;">
                          <button
                            id={"retry-suite-result-#{suite_run.id}-#{result["test_case_id"]}"}
                            type="button"
                            phx-click="retry_suite_result"
                            phx-value-suite-run-id={suite_run.id}
                            phx-value-test-case-id={result["test_case_id"]}
                            phx-disable-with="Retrying..."
                            disabled={@running}
                            style="border: 1px solid var(--border); background: var(--bg-tertiary); color: var(--text-secondary); border-radius: 8px; padding: 4px 10px; font-size: 11px; font-weight: 600; cursor: pointer; transition: background-color 0.2s ease, color 0.2s ease;"
                          >
                            Retry
                          </button>
                          <button
                            id={"copy-suite-result-#{suite_run.id}-#{result["test_case_id"]}"}
                            type="button"
                            phx-hook="CopyToClipboard"
                            phx-update="ignore"
                            data-copy-target={"suite-result-output-#{suite_run.id}-#{result["test_case_id"]}"}
                            data-copy-label="Copy output"
                            style="border: 1px solid var(--border); background: var(--bg-tertiary); color: var(--text-secondary); border-radius: 8px; padding: 4px 10px; font-size: 11px; font-weight: 600; cursor: pointer; transition: background-color 0.2s ease, color 0.2s ease;"
                          >
                            Copy output
                          </button>
                        </div>
                      </div>
                      <pre
                        id={"suite-result-output-#{suite_run.id}-#{result["test_case_id"]}"}
                        style="font-size: 12px; margin: 0; white-space: pre-wrap; color: var(--text-primary); line-height: 1.5;"
                      >{result["output"]}</pre>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <%= if not @running do %>
          <div
            class="aludel-card"
            style="padding: 32px; text-align: center; color: var(--text-muted);"
          >
            <div style="font-size: 14px; margin-bottom: 8px;">No results yet</div>
            <div style="font-size: 12px;">Run the suite to see results here</div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <%!-- Delete Confirmation Modals --%>
  <.modal
    :for={test_case <- @suite.test_cases}
    id={"confirm-delete-test-case-#{test_case.id}"}
    on_confirm={JS.push("delete_test_case", value: %{id: test_case.id})}
  >
    <div style="display: flex; align-items: start; gap: 12px; margin-bottom: 16px;">
      <div style="flex-shrink: 0; width: 40px; height: 40px; border-radius: 50%; background: rgba(220, 38, 38, 0.1); display: flex; align-items: center; justify-content: center;">
        <span class="hero-exclamation-triangle size-5" style="color: #dc2626;"></span>
      </div>
      <div style="flex: 1;">
        <h3 style="font-size: 16px; font-weight: 600; margin: 0 0 8px 0;">Delete Test Case</h3>
        <p style="font-size: 14px; color: var(--text-muted); margin: 0;">
          Are you sure you want to delete this test case? This action cannot be undone.
        </p>
      </div>
    </div>
    <:confirm>Delete Test Case</:confirm>
    <:cancel>Cancel</:cancel>
  </.modal>

  <%= for test_case <- @suite.test_cases, doc <- test_case.documents do %>
    <.modal
      id={"confirm-delete-document-#{doc.id}"}
      on_confirm={JS.push("delete_document", value: %{"doc-id": doc.id, id: test_case.id})}
    >
      <div style="display: flex; align-items: start; gap: 12px; margin-bottom: 16px;">
        <div style="flex-shrink: 0; width: 40px; height: 40px; border-radius: 50%; background: rgba(220, 38, 38, 0.1); display: flex; align-items: center; justify-content: center;">
          <span class="hero-exclamation-triangle size-5" style="color: #dc2626;"></span>
        </div>
        <div style="flex: 1;">
          <h3 style="font-size: 16px; font-weight: 600; margin: 0 0 8px 0;">Delete Document</h3>
          <p style="font-size: 14px; color: var(--text-muted); margin: 0;">
            Are you sure you want to delete "<strong>{doc.filename}</strong>"? This action cannot be undone.
          </p>
        </div>
      </div>
      <:confirm>Delete Document</:confirm>
      <:cancel>Cancel</:cancel>
    </.modal>
  <% end %>
</Layouts.app>
